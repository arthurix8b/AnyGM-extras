[anygm]
# Momodora III (GameMaker 8)
payload=Momodora3.exe

[overrides]
# [Render at game resolution] Same presentation as Momodora I and II: a 320x240 canvas blitted at
# the Screensize multiplier from momo.config.ini.
?gameres screener:screen_scale=1
?gameres view_wport[0]=320
?gameres view_hport[0]=240
